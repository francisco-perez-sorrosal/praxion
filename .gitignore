.DS_Store

claude/config/settings.local.json

# Rendered Claude global prompt + saved personal identifiers (user-specific,
# generated by install_claude.sh from claude/config/CLAUDE.md.tmpl)
claude/config/CLAUDE.md
claude/config/.personal_info.env

.cursor/
.agents/
.codex/

# The following skills belong to another project.
skills/ticker
skills/stock-clusters

# Python build artifacts
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Node / JavaScript / TypeScript build artifacts
node_modules/
.pnpm-store/
.next/
dist/
build/
out/
coverage/
*.tsbuildinfo
.turbo/
.parcel-cache/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage artifacts (generated by pytest-cov; consumed by test-coverage skill)
coverage.xml
.coverage
.coverage.*

# Agent intermediate documents
.ai-work/

# Scratch. CLAUDE.md's always-loaded Critical Conventions direct every writer
# here ("temp files in `tmp/`"), so the protection has to exist or the
# instruction hands out a path one `git add -A` away from being committed.
tmp/

# Runtime ephemeral files (concurrency locks, transient backups)
.ai-state/*.lock
.ai-state/**/*.lock
.ai-state/*.backup.json
.ai-state/observations.jsonl.1
.ai-state/*.pre-forget.json

# User-specific local settings
**/.claude/settings.local.json

# Environment files (secrets)
.env
.env.*
.env.local

# Obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/appearance.json
.obsidian/*.compat.json
.obsidian/hotkeys.json
# Third-party community plugin code — per-user install, not vendored.
# community-plugins.json (the enabled-list) IS committed as a recommendation.
.obsidian/plugins/

# Praxion carries no living ROADMAP.md — regenerated on demand by /roadmap (dec-092)
ROADMAP.md

# Release-workflow console capture (release.yml tees cz bump output here on the
# runner); must stay untracked or cz's `git commit -a` folds it into the bump commit
bump_output.txt
