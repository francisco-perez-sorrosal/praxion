# Canonical Praxion baseline CI-autofix policy template — per-repo tunables read
# by the `reusable-ci-autofix.yml` hub (installed alongside `ci-autofix.yml.tmpl`
# as the caller).
#
# Single source of truth for what an installed ci-autofix caller may tune.
# Every value below is read by the hub from THIS file — the caller workflow
# stays thin and never hardcodes safety/behavior tunables. Changing this file
# changes behavior; no caller edit required. The /onboard-project ci-autofix
# onboarding sub-step installs this as `.github/autofix-policy.yml` when
# neither that file nor `.github/workflows/ci-autofix.yml` already exists —
# never overwriting an existing installation. Delete this comment after
# tailoring.

watched_workflows: [Test]   # Documentary only — the caller's own
                            # on.workflow_run.workflows is the GHA-required
                            # static literal and is authoritative. Keep this
                            # list in sync with that literal by hand.

surfaces:
  main_branch: fix-pr       # fix-pr | off
  pr_checks:   fix-commit   # Live — the hub applies same-repo human-PR fixes as commits
  dependabot:  fix-commit   # Live — the hub applies Dependabot-PR fixes as commits
  fork_prs:    suggest      # Live — the hub posts fork-PR fix suggestions (no push access)

review:                        # Consumed live by reusable-cross-model-review.yml
                                # (built and dogfooding on Praxion's own
                                # ci-autofix/* PRs — see cross-model-review.yml.tmpl
                                # in this directory for the caller shape).
  cross_model_gate: agent-prs  # all-prs | agent-prs | off
  reviewer_family: gpt         # gpt | gemini | composer — NEVER 'claude': the
                                # fixer below is already claude, so a
                                # same-family value is a hard misconfiguration
                                # the hub labels `cross-model-review:misconfigured`
                                # and exits 0 without running a review.
  on_unavailable: fail-open    # fail-open is the only value the hub implements;
                                # fail-closed is reserved, not implemented.

safety:
  max_attempts_per_pr: 2
  max_runs_per_day: 5
  sensitive_paths: [.github/, scripts/, hooks/]
  auto_commit_tiers: [lint, format, doc-refs, lockfile]

provider:
  fixer: claude               # 'cursor' is a documented P1 break-glass value —
                               # the hub errors clearly if selected; not
                               # implemented in P1.
  fixer_model: opus           # Replaces the old hardcoded --model opus literal.
  # plugin_dir: "."           # Optional — NO default (unlike fixer/fixer_model
                               # above). Only set this if the caller repo's own
                               # CI needs to load its own skills/agents as a
                               # Claude Code plugin root (the --plugin-dir
                               # flag). Praxion's own caller sets this to "."
                               # to preserve its pre-hub dogfooding behavior;
                               # most managed repos should leave it
                               # unset/commented.
  # js_test_runner: off       # Optional enum: off | vitest | jest | npm-test |
                               # pnpm-test. Defaults to "off" — a missing or
                               # malformed value never grants the fixer agent
                               # a test-runner tool. The enum selects ONLY the
                               # runner invocation (e.g. `./node_modules/.bin/
                               # vitest run`), via a hardcoded table — never a
                               # free-form command. When set, the hub also
                               # adds a non-agent install step (lifecycle
                               # scripts disabled via --ignore-scripts) and
                               # grants the fixer agent EXACTLY the runner
                               # invocation, never an install command. The
                               # install command is picked separately: the hub
                               # DETECTS the package manager from whichever
                               # lockfile (pnpm-lock.yaml, yarn.lock, or
                               # package-lock.json — checked in that
                               # precedence) is present in the trusted
                               # default-branch tree, then provisions pnpm/
                               # yarn via the runner's bundled `corepack
                               # enable` — no explicit package-manager key is
                               # needed here.
  # js_project_dir: ""        # Optional — NO default. Set this only when the
                               # JS/TS project lives in a subdirectory rather
                               # than the repo root (e.g. a monorepo's
                               # frontend/ or dashboard/ folder). Applied as a
                               # uniform `cd <dir> &&` prefix to both the
                               # install and runner commands above.
