# Canonical Praxion baseline test workflow — the full parallel suite on every
# push and pull request, with a ratchet coverage floor.
#
# Single source of truth for the installable test workflow. The /onboard-project
# `tests` capability (sub-step 8e.13) installs this as `.github/workflows/test.yml`
# when that file does not already exist — never overwriting an existing one.
# It KEEPS the PYTHON job only when Python is detected, the JS/TS job only when
# package.json is present, and the RUST job only when Cargo.toml is detected,
# stripping each non-applicable stack block before writing. Two placeholders are
# filled at install time, per kept block:
#   {{FULL_TEST_COMMAND}} — that stack's full-suite command (`uv run pytest`,
#     `npx vitest run`, `cargo test --workspace`). Parallelism comes from the
#     runner config, not from flags here.
#   {{COVERAGE_FLOOR}}    — the line-coverage floor (Python only). A ratchet:
#     raise it as measured coverage rises; never lower it to go green.
#
# This is the backstop loop: agents and developers run a derived selection
# locally, and this workflow runs everything. Coverage is measured here, not in
# the local default run. Actions are SHA-pinned. Delete this comment after
# tailoring.

name: Test

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: test-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # --- PYTHON (keep iff Python detected) --------------------------------------
  test-python:
    name: Test (Python)
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1

      - name: Set up uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9  # v9.0.0

      - name: Full suite (parallel) with the coverage floor
        # Coverage is requested here, not in the runner config's addopts: it is
        # the backstop's measurement, and pytest-cov combines the xdist workers.
        # A brand-new project has no tests yet. Collection alone tells us so
        # (exit 5); with a coverage floor pytest would report exit 1 instead,
        # so the check runs first and the floor applies only once tests exist.
        run: |
          set +e
          {{FULL_TEST_COMMAND}} --collect-only -q -n 0 > /dev/null
          if [ "$?" -eq 5 ]; then
            echo "No tests collected yet; the coverage floor applies once tests exist."
            exit 0
          fi
          set -e
          {{FULL_TEST_COMMAND}} \
            --cov --cov-report=xml --cov-report=term \
            --cov-fail-under={{COVERAGE_FLOOR}} \
            --junitxml=junit.xml

      - name: Upload test reports
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7.0.1
        with:
          name: test-reports-python
          path: |
            junit.xml
            coverage.xml
          if-no-files-found: warn

  # --- JS/TS (keep iff package.json present) ----------------------------------
  test-js:
    name: Test (JS/TS)
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1

      - name: Set up Node
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020  # v7
        with:
          node-version: "lts/*"

      - name: Install dependencies (package manager from the lockfile)
        run: |
          corepack enable
          if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile
          elif [ -f yarn.lock ]; then yarn install --frozen-lockfile
          else npm ci
          fi

      - name: Full suite
        # vitest runs test files in parallel with coverage off by default. Add a
        # floor (--coverage.enabled --coverage.thresholds.lines=<n>) once a
        # coverage provider is a dev dependency.
        run: >-
          {{FULL_TEST_COMMAND}}

  # --- RUST (keep iff Cargo.toml detected) ------------------------------------
  test-rust:
    name: Test (Rust)
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1

      - name: Full suite
        # The runner image ships a stable toolchain; rust-toolchain.toml, when
        # present, pins it. `cargo test` also runs doc-tests.
        run: >-
          {{FULL_TEST_COMMAND}}
