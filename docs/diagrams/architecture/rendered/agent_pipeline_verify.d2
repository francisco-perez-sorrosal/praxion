direction: down
vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
    theme-overrides: {
      N1: "#0F172A"
      N2: "#334155"
      N7: "#FFFFFF"
    }
  }
}
classes: {
  category_runtime_agent: {
    shape: rectangle
    style: {
      fill: "#FDEFD9"
      stroke: "#A85A00"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
      border-radius: 16
    }
  }
  category_pipeline_document: {
    shape: document
    style: {
      fill: "#E3F1FB"
      stroke: "#0B6FA4"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
    }
  }
  line_acts_on: {
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      stroke-width: 2
      font-color: "#334155"
      font-size: 14
    }
  }
  line_read_only: {
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      stroke-width: 2
      font-color: "#334155"
      font-size: 14
      stroke-dash: 5
    }
  }
}
Title: {
  label: "Agent pipeline, verification — Component diagram"
  shape: text
  near: top-center
  style: {
    font-size: 24
    bold: true
    font-color: "#0F172A"
  }
}
"el_praxion.orchestration.doc_test": {
  label: "TEST_RESULTS.md\n[Pipeline document]\ntest-run handoff"
  class: category_pipeline_document
}
"el_praxion.orchestration.doc_verify": {
  label: "VERIFICATION_REPORT.md\n[Pipeline document]\nverifier output"
  class: category_pipeline_document
}
"el_praxion.orchestration.doc_wip": {
  label: "WIP.md\n[Pipeline document]\nstep state"
  class: category_pipeline_document
}
"el_praxion.orchestration.pipeline.verifier": {
  label: "Verifier\n[Runtime agent]\nAcceptance + rework manifest\nemitter (Phase 12.5)"
  class: category_runtime_agent
}
Legend: {
  label: "Legend"
  near: bottom-center
  grid-columns: 3
  width: 1250
  horizontal-gap: 56
  vertical-gap: 12
  style: {
    fill: "#FFFFFF"
    stroke: "#8C8780"
    stroke-width: 1
    font-color: "#0F172A"
  }
  category_runtime_agent: {
    label: "Runtime agent"
    class: category_runtime_agent
  }
  category_pipeline_document: {
    label: "Pipeline document"
    class: category_pipeline_document
  }
  line_acts_on_sample: {
    label: ""
    direction: right
    style: {
      fill: transparent
      stroke-width: 0
    }
    tail: {
      label: ""
      shape: circle
      width: 8
      height: 8
      style: {
        fill: "#475569"
        stroke: "#475569"
      }
    }
    caption: {
      label: "acts on (invokes, writes)"
      style: {
        fill: transparent
        stroke-width: 0
        font-size: 14
        font-color: "#334155"
      }
    }
    tail -> caption: {
      class: line_acts_on
    }
  }
  line_read_only_sample: {
    label: ""
    direction: right
    style: {
      fill: transparent
      stroke-width: 0
    }
    tail: {
      label: ""
      shape: circle
      width: 8
      height: 8
      style: {
        fill: "#475569"
        stroke: "#475569"
      }
    }
    caption: {
      label: "read-only flow (consumed, not modified)"
      style: {
        fill: transparent
        stroke-width: 0
        font-size: 14
        font-color: "#334155"
      }
    }
    tail -> caption: {
      class: line_read_only
    }
  }
}
"el_praxion.orchestration.doc_test" -> "el_praxion.orchestration.pipeline.verifier": "is read by" {class: line_read_only}
"el_praxion.orchestration.doc_wip" -> "el_praxion.orchestration.pipeline.verifier": "is read by" {class: line_read_only}
"el_praxion.orchestration.pipeline.verifier" -> "el_praxion.orchestration.doc_verify": "writes" {class: line_acts_on}
