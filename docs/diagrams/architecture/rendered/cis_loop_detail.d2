direction: down
vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
    theme-overrides: {
      N1: "#0F172A"
      N2: "#334155"
      N7: "#FFFFFF"
    }
  }
}
classes: {
  category_runtime_agent: {
    shape: rectangle
    style: {
      fill: "#FDEFD9"
      stroke: "#A85A00"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
      border-radius: 16
    }
  }
  category_pipeline_document: {
    shape: document
    style: {
      fill: "#E3F1FB"
      stroke: "#0B6FA4"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
    }
  }
  category_persistent_store: {
    shape: cylinder
    style: {
      fill: "#F6E6F0"
      stroke: "#9B3A75"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
    }
  }
  line_step: {
    style: {
      fill: "#FFFFFF"
      stroke: "#4338CA"
      stroke-width: 3
      font-color: "#334155"
      font-size: 14
    }
  }
}
Title: {
  label: "Continuous improvement signals loop — Dynamic diagram"
  shape: text
  near: top-center
  style: {
    font-size: 24
    bold: true
    font-color: "#0F172A"
  }
}
"el_praxion.orchestration.doc_research": {
  label: "RESEARCH_FINDINGS.md\n[Pipeline document]\nresearcher output; carries\nCIS section"
  class: category_pipeline_document
}
"el_praxion.orchestration.doc_systems": {
  label: "SYSTEMS_PLAN.md\n[Pipeline document]\narchitect output; carries\ndispositions"
  class: category_pipeline_document
}
"el_praxion.orchestration.orchestrator": {
  label: "Main Agent (Orchestrator)\n[Runtime agent]\nTier selector, task-slug\npropagator, rework-worktree\nspawner, subagent dispatcher"
  class: category_runtime_agent
}
"el_praxion.orchestration.pipeline.architect": {
  label: "Systems Architect\n[Runtime agent]\nTrade-off analysis; CIS\ndisposition; rework\nfirst-stop"
  class: category_runtime_agent
}
"el_praxion.orchestration.pipeline.researcher": {
  label: "Researcher\n[Runtime agent]\nHat 1 codebase + Hat 2\nexternal research; surfaces\nCIS"
  class: category_runtime_agent
}
"el_praxion.orchestration.pipeline.sentinel": {
  label: "Sentinel\n[Runtime agent]\nRead-only ecosystem auditor\n(independent)"
  class: category_runtime_agent
}
"el_praxion.orchestration.pipeline.verifier": {
  label: "Verifier\n[Runtime agent]\nAcceptance + rework manifest\nemitter (Phase 12.5)"
  class: category_runtime_agent
}
"el_praxion.persistence.adrs": {
  label: "ADR Fragments\n[Persistent store]\n.ai-state/decisions/drafts/\n— finalized at merge-to-main"
  class: category_persistent_store
}
"el_praxion.persistence.tdl": {
  label: "Tech-Debt Ledger\n[Persistent store]\n.ai-state/TECH_DEBT_LEDGER.md\n(+ RESOLVED)"
  class: category_persistent_store
}
Legend: {
  label: "Legend"
  near: bottom-center
  grid-columns: 3
  width: 1250
  horizontal-gap: 56
  vertical-gap: 12
  style: {
    fill: "#FFFFFF"
    stroke: "#8C8780"
    stroke-width: 1
    font-color: "#0F172A"
  }
  category_runtime_agent: {
    label: "Runtime agent"
    class: category_runtime_agent
  }
  category_pipeline_document: {
    label: "Pipeline document"
    class: category_pipeline_document
  }
  category_persistent_store: {
    label: "Persistent store"
    class: category_persistent_store
  }
  line_step_sample: {
    label: ""
    direction: right
    style: {
      fill: transparent
      stroke-width: 0
    }
    tail: {
      label: ""
      shape: circle
      width: 8
      height: 8
      style: {
        fill: "#4338CA"
        stroke: "#4338CA"
      }
    }
    caption: {
      label: "numbered step, in order (dynamic views)"
      style: {
        fill: transparent
        stroke-width: 0
        font-size: 14
        font-color: "#334155"
      }
    }
    tail -> caption: {
      class: line_step
    }
  }
}
"el_praxion.orchestration.pipeline.researcher" -> "el_praxion.orchestration.doc_research": "1 · surfaces the CIS section" {class: line_step}
"el_praxion.orchestration.doc_research" -> "el_praxion.orchestration.pipeline.architect": "2 · signals CIS to" {class: line_step}
"el_praxion.orchestration.pipeline.architect" -> "el_praxion.orchestration.doc_systems": "3 · records a disposition per signal" {class: line_step}
"el_praxion.orchestration.pipeline.architect" -> "el_praxion.persistence.adrs": "4 · writes an ADR fragment when load-bearing" {class: line_step}
"el_praxion.orchestration.orchestrator" -> "el_praxion.persistence.tdl": "5 · files a row from a deferred signal" {class: line_step}
"el_praxion.orchestration.pipeline.sentinel" -> "el_praxion.persistence.tdl": "5 · files a row from a deferred signal" {class: line_step}
"el_praxion.orchestration.pipeline.verifier" -> "el_praxion.persistence.tdl": "5 · files a row from a deferred signal" {class: line_step}
