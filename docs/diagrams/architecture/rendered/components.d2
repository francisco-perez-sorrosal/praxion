vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
    theme-overrides: {
      N1: "#0F172A"
      N2: "#334155"
      N7: "#FFFFFF"
    }
  }
}
classes: {
  category_person: {
    shape: rectangle
    icon: "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PGNpcmNsZSBjeD0iMTIiIGN5PSI3IiByPSI0LjUiIGZpbGw9IiMxRDRFODkiLz48cGF0aCBkPSJNMyAyMmMwLTUgNC04LjUgOS04LjVzOSAzLjUgOSA4LjV6IiBmaWxsPSIjMUQ0RTg5Ii8+PC9zdmc+"
    style: {
      fill: "#E6F0FA"
      stroke: "#1D4E89"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
    }
  }
  category_external_system: {
    shape: rectangle
    style: {
      fill: "#ECEAE6"
      stroke: "#77726A"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
      stroke-dash: 5
    }
  }
  category_layer: {
    shape: rectangle
    style: {
      fill: "#FFFFFF"
      stroke: "#8C8780"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
      double-border: true
    }
  }
  category_system_in_scope_frame: {
    shape: rectangle
    style: {
      fill: "#EEF2FF"
      stroke: "#4338CA"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
    }
  }
  line_acts_on: {
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      stroke-width: 2
      font-color: "#334155"
      font-size: 14
    }
  }
  line_read_only: {
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      stroke-width: 2
      font-color: "#334155"
      font-size: 14
      stroke-dash: 5
    }
  }
}
Title: {
  label: "Praxion layers — Container diagram"
  shape: text
  near: top-center
  style: {
    font-size: 24
    bold: true
    font-color: "#0F172A"
  }
}
"el_anthropic_api": {
  label: "Anthropic API\n[External system]"
  class: category_external_system
}
"el_arize_phoenix": {
  label: "Arize Phoenix\n[External system]"
  class: category_external_system
}
"el_claude_code": {
  label: "Claude Code\n[External system]"
  class: category_external_system
}
"el_claude_desktop": {
  label: "Claude Desktop\n[External system]"
  class: category_external_system
}
"el_cursor": {
  label: "Cursor\n[External system]"
  class: category_external_system
}
"el_developer": {
  label: "Developer\n[Person]"
  class: category_person
}
"el_github": {
  label: "GitHub\n[External system]"
  class: category_external_system
}
"el_praxion": {
  label: "Praxion\n[System in scope · Markdown, Python and shell]\nSkills, rules, commands and\nagents that equip an AI\ncoding assistant"
  class: category_system_in_scope_frame
  "el_praxion.knowledge": {
    label: "Knowledge Layer\n[Layer]"
    class: category_layer
  }
  "el_praxion.orchestration": {
    label: "Orchestration Layer\n[Layer]"
    class: category_layer
  }
  "el_praxion.persistence": {
    label: "Persistence Layer\n[Layer]"
    class: category_layer
  }
  "el_praxion.tooling": {
    label: "Tooling\n[Layer]"
    class: category_layer
  }
}
Legend: {
  label: "Legend"
  near: bottom-center
  grid-columns: 4
  horizontal-gap: 40
  vertical-gap: 12
  style: {
    fill: "#FFFFFF"
    stroke: "#8C8780"
    stroke-width: 1
    font-color: "#0F172A"
  }
  category_person: {
    label: "Person"
    class: category_person
  }
  category_external_system: {
    label: "External system"
    class: category_external_system
  }
  category_layer: {
    label: "Layer"
    class: category_layer
  }
  category_system_in_scope_frame: {
    label: "System in scope (boundary)"
    class: category_system_in_scope_frame
  }
  line_acts_on_sample: {
    label: ""
    direction: right
    style: {
      fill: transparent
      stroke-width: 0
    }
    tail: {
      label: ""
      shape: circle
      width: 8
      height: 8
      style: {
        fill: "#475569"
        stroke: "#475569"
      }
    }
    caption: {
      label: "acts on (invokes, writes)"
      style: {
        fill: transparent
        stroke-width: 0
        font-size: 14
        font-color: "#334155"
      }
    }
    tail -> caption: {
      class: line_acts_on
    }
  }
  line_read_only_sample: {
    label: ""
    direction: right
    style: {
      fill: transparent
      stroke-width: 0
    }
    tail: {
      label: ""
      shape: circle
      width: 8
      height: 8
      style: {
        fill: "#475569"
        stroke: "#475569"
      }
    }
    caption: {
      label: "read-only flow (consumed, not modified)"
      style: {
        fill: transparent
        stroke-width: 0
        font-size: 14
        font-color: "#334155"
      }
    }
    tail -> caption: {
      class: line_read_only
    }
  }
}
"el_claude_code" -> "el_praxion": "executes agents" {class: line_acts_on}
"el_claude_desktop" -> "el_praxion": "loads skills" {class: line_acts_on}
"el_cursor" -> "el_praxion": "loads rules" {class: line_acts_on}
"el_developer" -> "el_praxion": "develops" {class: line_acts_on}
"el_github" -> "el_praxion": "hosts" {class: line_acts_on}
"el_praxion"."el_praxion.knowledge" -> "el_praxion"."el_praxion.orchestration": "constrains +4 more" {class: line_acts_on}
"el_praxion"."el_praxion.orchestration" -> "el_praxion"."el_praxion.knowledge": "auto-discovered by /resume-rework" {class: line_acts_on}
"el_praxion"."el_praxion.orchestration" -> "el_praxion"."el_praxion.persistence": "emits events (HTTP) +8 more" {class: line_acts_on}
"el_praxion"."el_praxion.orchestration" -> "el_praxion"."el_praxion.tooling": "spawns rework worktree per row (EnterWorktree)" {class: line_acts_on}
"el_praxion"."el_praxion.persistence" -> "el_arize_phoenix": "streams via OTLP" {class: line_acts_on}
"el_praxion"."el_praxion.tooling" -> "el_anthropic_api": "judges via the JudgeClient adapter" {class: line_acts_on}
"el_praxion"."el_praxion.tooling" -> "el_praxion"."el_praxion.knowledge": "deploys +3 more" {class: line_acts_on}
"el_praxion"."el_praxion.tooling" -> "el_praxion"."el_praxion.orchestration": "reads in-flight pipeline docs (read-only)" {class: line_read_only}
"el_praxion"."el_praxion.tooling" -> "el_praxion"."el_praxion.persistence": "finalize_adrs.py promotes drafts to dec-NNN +3 more" {class: line_acts_on}
