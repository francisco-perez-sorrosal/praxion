direction: down
vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
    theme-overrides: {
      N1: "#0F172A"
      N2: "#334155"
      N7: "#FFFFFF"
    }
  }
}
classes: {
  category_runtime_agent: {
    shape: rectangle
    style: {
      fill: "#FDEFD9"
      stroke: "#A85A00"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
      border-radius: 16
    }
  }
  category_pipeline_document: {
    shape: document
    style: {
      fill: "#E3F1FB"
      stroke: "#0B6FA4"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
    }
  }
  category_persistent_store: {
    shape: cylinder
    style: {
      fill: "#F6E6F0"
      stroke: "#9B3A75"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
    }
  }
  category_runtime_agent_frame: {
    shape: rectangle
    style: {
      fill: transparent
      stroke: "#A85A00"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
      stroke-dash: 5
      border-radius: 16
    }
  }
  category_layer_frame: {
    shape: rectangle
    style: {
      fill: transparent
      stroke: "#8C8780"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
      stroke-dash: 5
    }
  }
  line_acts_on: {
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      stroke-width: 2
      font-color: "#334155"
      font-size: 14
    }
  }
  line_read_only: {
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      stroke-width: 2
      font-color: "#334155"
      font-size: 14
      stroke-dash: 5
    }
  }
}
Title: {
  label: "Independent and post-pipeline agents — Component diagram"
  shape: text
  near: top-center
  style: {
    font-size: 24
    bold: true
    font-color: "#0F172A"
  }
}
"el_praxion.orchestration": {
  label: "Orchestration\n[Layer]"
  class: category_layer_frame
  "el_praxion.orchestration.doc_learnings": {
    label: "LEARNINGS.md\n[Pipeline document]\nin-flight knowledge"
    class: category_pipeline_document
  }
  "el_praxion.orchestration.orchestrator": {
    label: "Main Agent (Orchestrator)\n[Runtime agent]\nTier selector, task-slug\npropagator, rework-worktree\nspawner, subagent dispatcher"
    class: category_runtime_agent
  }
  "el_praxion.orchestration.pipeline": {
    label: "Agent Pipeline\n[Runtime agent]\nSpawned subprocesses\n(runtime instances)"
    class: category_runtime_agent_frame
    "el_praxion.orchestration.pipeline.arch_validator": {
      label: "Architect Validator\n[Runtime agent]\nPer-PR DSL <-> code <-> ADR\ntriangle check"
      class: category_runtime_agent
    }
    "el_praxion.orchestration.pipeline.sentinel": {
      label: "Sentinel\n[Runtime agent]\nRead-only ecosystem auditor\n(independent)"
      class: category_runtime_agent
    }
    "el_praxion.orchestration.pipeline.skill_genesis": {
      label: "Skill Genesis\n[Runtime agent]\nLearning triage; artifact\nproposal"
      class: category_runtime_agent
    }
  }
}
"el_praxion.persistence": {
  label: "Persistence\n[Layer]"
  class: category_layer_frame
  "el_praxion.persistence.tdl": {
    label: "Tech-Debt Ledger\n[Persistent store]\n.ai-state/TECH_DEBT_LEDGER.md\n(+ RESOLVED)"
    class: category_persistent_store
  }
}
Legend: {
  label: "Legend"
  near: bottom-center
  grid-columns: 3
  width: 1250
  horizontal-gap: 56
  vertical-gap: 12
  style: {
    fill: "#FFFFFF"
    stroke: "#8C8780"
    stroke-width: 1
    font-color: "#0F172A"
  }
  category_runtime_agent: {
    label: "Runtime agent"
    class: category_runtime_agent
  }
  category_pipeline_document: {
    label: "Pipeline document"
    class: category_pipeline_document
  }
  category_persistent_store: {
    label: "Persistent store"
    class: category_persistent_store
  }
  category_runtime_agent_frame: {
    label: "Runtime agent (boundary)"
    class: category_runtime_agent_frame
  }
  category_layer_frame: {
    label: "Layer (boundary)"
    class: category_layer_frame
  }
  line_acts_on_sample: {
    label: ""
    direction: right
    style: {
      fill: transparent
      stroke-width: 0
    }
    tail: {
      label: ""
      shape: circle
      width: 8
      height: 8
      style: {
        fill: "#475569"
        stroke: "#475569"
      }
    }
    caption: {
      label: "acts on (invokes, writes)"
      style: {
        fill: transparent
        stroke-width: 0
        font-size: 14
        font-color: "#334155"
      }
    }
    tail -> caption: {
      class: line_acts_on
    }
  }
  line_read_only_sample: {
    label: ""
    direction: right
    style: {
      fill: transparent
      stroke-width: 0
    }
    tail: {
      label: ""
      shape: circle
      width: 8
      height: 8
      style: {
        fill: "#475569"
        stroke: "#475569"
      }
    }
    caption: {
      label: "read-only flow (consumed, not modified)"
      style: {
        fill: transparent
        stroke-width: 0
        font-size: 14
        font-color: "#334155"
      }
    }
    tail -> caption: {
      class: line_read_only
    }
  }
}
"el_praxion.orchestration"."el_praxion.orchestration.orchestrator" -> "el_praxion.orchestration"."el_praxion.orchestration.pipeline"."el_praxion.orchestration.pipeline.arch_validator": "dispatches (per-PR)" {class: line_acts_on}
"el_praxion.orchestration"."el_praxion.orchestration.orchestrator" -> "el_praxion.orchestration"."el_praxion.orchestration.pipeline"."el_praxion.orchestration.pipeline.sentinel": "dispatches (independent)" {class: line_acts_on}
"el_praxion.orchestration"."el_praxion.orchestration.orchestrator" -> "el_praxion.orchestration"."el_praxion.orchestration.pipeline"."el_praxion.orchestration.pipeline.skill_genesis": "dispatches (post-pipeline)" {class: line_acts_on}
"el_praxion.orchestration"."el_praxion.orchestration.orchestrator" -> "el_praxion.persistence"."el_praxion.persistence.tdl": "files row from deferred CIS +1 more" {class: line_acts_on}
"el_praxion.orchestration"."el_praxion.orchestration.pipeline"."el_praxion.orchestration.pipeline.arch_validator" -> "el_praxion.persistence"."el_praxion.persistence.tdl": "files drift rows" {class: line_acts_on}
"el_praxion.orchestration"."el_praxion.orchestration.pipeline"."el_praxion.orchestration.pipeline.sentinel" -> "el_praxion.persistence"."el_praxion.persistence.tdl": "files row from deferred CIS" {class: line_acts_on}
"el_praxion.orchestration"."el_praxion.orchestration.pipeline"."el_praxion.orchestration.pipeline.skill_genesis" -> "el_praxion.orchestration"."el_praxion.orchestration.doc_learnings": "reads at pipeline-end" {class: line_read_only}
