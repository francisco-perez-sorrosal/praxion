direction: down
vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
    theme-overrides: {
      N1: "#0F172A"
      N2: "#334155"
      N7: "#FFFFFF"
    }
  }
}
classes: {
  category_knowledge_asset: {
    shape: package
    style: {
      fill: "#E1F3EC"
      stroke: "#00684A"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
    }
  }
  category_runtime_agent: {
    shape: rectangle
    style: {
      fill: "#FDEFD9"
      stroke: "#A85A00"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
      border-radius: 16
    }
  }
  category_pipeline_document: {
    shape: document
    style: {
      fill: "#E3F1FB"
      stroke: "#0B6FA4"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
    }
  }
  category_persistent_store: {
    shape: cylinder
    style: {
      fill: "#F6E6F0"
      stroke: "#9B3A75"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
    }
  }
  category_tooling: {
    shape: rectangle
    style: {
      fill: "#F2F4F7"
      stroke: "#3F4B5C"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
      3d: true
    }
  }
  line_step: {
    style: {
      fill: "#FFFFFF"
      stroke: "#4338CA"
      stroke-width: 3
      font-color: "#334155"
      font-size: 14
    }
  }
}
Title: {
  label: "Rework loop — Dynamic diagram"
  shape: text
  near: top-center
  style: {
    font-size: 24
    bold: true
    font-color: "#0F172A"
  }
}
"el_praxion.knowledge.commands": {
  label: "Commands\n[Knowledge asset]\nUser-invoked workflows"
  class: category_knowledge_asset
}
"el_praxion.orchestration.doc_findings": {
  label: "VERIFIER_FINDINGS.md\n[Pipeline document]\norchestrator writes one per\nrework worktree"
  class: category_pipeline_document
}
"el_praxion.orchestration.doc_rework": {
  label: "REWORK_MANIFEST.md\n[Pipeline document]\nverifier Phase 12.5 output;\nper-row fenced JSON\nauthoritative"
  class: category_pipeline_document
}
"el_praxion.orchestration.doc_systems": {
  label: "SYSTEMS_PLAN.md\n[Pipeline document]\narchitect output; carries\ndispositions"
  class: category_pipeline_document
}
"el_praxion.orchestration.orchestrator": {
  label: "Main Agent (Orchestrator)\n[Runtime agent]\nTier selector, task-slug\npropagator, rework-worktree\nspawner, subagent dispatcher"
  class: category_runtime_agent
}
"el_praxion.orchestration.pipeline.architect": {
  label: "Systems Architect\n[Runtime agent]\nTrade-off analysis; CIS\ndisposition; rework\nfirst-stop"
  class: category_runtime_agent
}
"el_praxion.orchestration.pipeline.verifier": {
  label: "Verifier\n[Runtime agent]\nAcceptance + rework manifest\nemitter (Phase 12.5)"
  class: category_runtime_agent
}
"el_praxion.persistence.tdl": {
  label: "Tech-Debt Ledger\n[Persistent store]\n.ai-state/TECH_DEBT_LEDGER.md\n(+ RESOLVED)"
  class: category_persistent_store
}
"el_praxion.tooling.scripts": {
  label: "Scripts\n[Tooling]\nWorktrees, merge, Phoenix,\nfinalize"
  class: category_tooling
}
Legend: {
  label: "Legend"
  near: bottom-center
  grid-columns: 3
  width: 1250
  horizontal-gap: 56
  vertical-gap: 12
  style: {
    fill: "#FFFFFF"
    stroke: "#8C8780"
    stroke-width: 1
    font-color: "#0F172A"
  }
  category_knowledge_asset: {
    label: "Knowledge asset"
    class: category_knowledge_asset
  }
  category_runtime_agent: {
    label: "Runtime agent"
    class: category_runtime_agent
  }
  category_pipeline_document: {
    label: "Pipeline document"
    class: category_pipeline_document
  }
  category_persistent_store: {
    label: "Persistent store"
    class: category_persistent_store
  }
  category_tooling: {
    label: "Tooling"
    class: category_tooling
  }
  line_step_sample: {
    label: ""
    direction: right
    style: {
      fill: transparent
      stroke-width: 0
    }
    tail: {
      label: ""
      shape: circle
      width: 8
      height: 8
      style: {
        fill: "#4338CA"
        stroke: "#4338CA"
      }
    }
    caption: {
      label: "numbered step, in order (dynamic views)"
      style: {
        fill: transparent
        stroke-width: 0
        font-size: 14
        font-color: "#334155"
      }
    }
    tail -> caption: {
      class: line_step
    }
  }
}
"el_praxion.orchestration.pipeline.verifier" -> "el_praxion.orchestration.doc_rework": "1 · emits Phase 12.5" {class: line_step}
"el_praxion.orchestration.doc_rework" -> "el_praxion.orchestration.orchestrator": "2 · hands the manifest to" {class: line_step}
"el_praxion.orchestration.orchestrator" -> "el_praxion.tooling.scripts": "3 · spawns a worktree per row" {class: line_step}
"el_praxion.orchestration.orchestrator" -> "el_praxion.orchestration.doc_findings": "4 · writes a findings file per worktree" {class: line_step}
"el_praxion.orchestration.orchestrator" -> "el_praxion.persistence.tdl": "5 · flips linked td-NNN rows to in-flight" {class: line_step}
"el_praxion.orchestration.doc_findings" -> "el_praxion.knowledge.commands": "6 · is auto-discovered by /resume-rework" {class: line_step}
"el_praxion.knowledge.commands" -> "el_praxion.orchestration.pipeline.architect": "7 · dispatches the architect first" {class: line_step}
"el_praxion.orchestration.pipeline.architect" -> "el_praxion.orchestration.doc_systems": "8 · re-enters the pipeline at the plan" {class: line_step}
