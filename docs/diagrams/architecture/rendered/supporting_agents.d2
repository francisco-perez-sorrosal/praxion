direction: down
vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
    theme-overrides: {
      N1: "#0F172A"
      N2: "#334155"
      N7: "#FFFFFF"
    }
  }
}
classes: {
  category_runtime_agent: {
    shape: rectangle
    style: {
      fill: "#FDEFD9"
      stroke: "#A85A00"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
      border-radius: 16
    }
  }
  category_pipeline_document: {
    shape: document
    style: {
      fill: "#E3F1FB"
      stroke: "#0B6FA4"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
    }
  }
  category_runtime_agent_frame: {
    shape: rectangle
    style: {
      fill: transparent
      stroke: "#A85A00"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
      stroke-dash: 5
      border-radius: 16
    }
  }
  line_acts_on: {
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      stroke-width: 2
      font-color: "#334155"
      font-size: 14
    }
  }
}
Title: {
  label: "Shadow and gated agents — Component diagram"
  shape: text
  near: top-center
  style: {
    font-size: 24
    bold: true
    font-color: "#0F172A"
  }
}
"el_praxion.orchestration.doc_context": {
  label: "CONTEXT_REVIEW.md\n[Pipeline document]\ncontext-engineer cumulative\nreview"
  class: category_pipeline_document
}
"el_praxion.orchestration.orchestrator": {
  label: "Main Agent (Orchestrator)\n[Runtime agent]\nTier selector, task-slug\npropagator, rework-worktree\nspawner, subagent dispatcher"
  class: category_runtime_agent
}
"el_praxion.orchestration.pipeline": {
  label: "Agent Pipeline\n[Runtime agent]\nSpawned subprocesses\n(runtime instances)"
  class: category_runtime_agent_frame
  "el_praxion.orchestration.pipeline.cicd_engineer": {
    label: "CI/CD Engineer\n[Runtime agent]\nPipeline design, GitHub\nActions, deployment\nautomation"
    class: category_runtime_agent
  }
  "el_praxion.orchestration.pipeline.context_eng": {
    label: "Context Engineer\n[Runtime agent]\nContext artifact domain\nexpert (shadow)"
    class: category_runtime_agent
  }
  "el_praxion.orchestration.pipeline.discipline_consultant": {
    label: "Discipline Consultant\n[Runtime agent]\nGated adversarial peer\nsub-architect, parameterized\nper spawn; challenges only,\ndecides nothing"
    class: category_runtime_agent
  }
  "el_praxion.orchestration.pipeline.roadmap_cartographer": {
    label: "Roadmap Cartographer\n[Runtime agent]\nProject-level\naudit-to-roadmap through a\nproject-derived lens set\n(on-demand)"
    class: category_runtime_agent
  }
}
Legend: {
  label: "Legend"
  near: bottom-center
  grid-columns: 3
  width: 1250
  horizontal-gap: 56
  vertical-gap: 12
  style: {
    fill: "#FFFFFF"
    stroke: "#8C8780"
    stroke-width: 1
    font-color: "#0F172A"
  }
  category_runtime_agent: {
    label: "Runtime agent"
    class: category_runtime_agent
  }
  category_pipeline_document: {
    label: "Pipeline document"
    class: category_pipeline_document
  }
  category_runtime_agent_frame: {
    label: "Runtime agent (boundary)"
    class: category_runtime_agent_frame
  }
  line_acts_on_sample: {
    label: ""
    direction: right
    style: {
      fill: transparent
      stroke-width: 0
    }
    tail: {
      label: ""
      shape: circle
      width: 8
      height: 8
      style: {
        fill: "#475569"
        stroke: "#475569"
      }
    }
    caption: {
      label: "acts on (invokes, writes)"
      style: {
        fill: transparent
        stroke-width: 0
        font-size: 14
        font-color: "#334155"
      }
    }
    tail -> caption: {
      class: line_acts_on
    }
  }
}
"el_praxion.orchestration.orchestrator" -> "el_praxion.orchestration.pipeline"."el_praxion.orchestration.pipeline.cicd_engineer": "dispatches" {class: line_acts_on}
"el_praxion.orchestration.orchestrator" -> "el_praxion.orchestration.pipeline"."el_praxion.orchestration.pipeline.context_eng": "dispatches (shadow)" {class: line_acts_on}
"el_praxion.orchestration.orchestrator" -> "el_praxion.orchestration.pipeline"."el_praxion.orchestration.pipeline.discipline_consultant": "dispatches (gated)" {class: line_acts_on}
"el_praxion.orchestration.orchestrator" -> "el_praxion.orchestration.pipeline"."el_praxion.orchestration.pipeline.roadmap_cartographer": "dispatches (on-demand)" {class: line_acts_on}
"el_praxion.orchestration.pipeline"."el_praxion.orchestration.pipeline.context_eng" -> "el_praxion.orchestration.doc_context": "writes (cumulative)" {class: line_acts_on}
