direction: down
vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
    theme-overrides: {
      N1: "#0F172A"
      N2: "#334155"
      N7: "#FFFFFF"
    }
  }
}
classes: {
  category_external_system: {
    shape: rectangle
    style: {
      fill: "#ECEAE6"
      stroke: "#77726A"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
      stroke-dash: 5
    }
  }
  category_pipeline_document: {
    shape: document
    style: {
      fill: "#E3F1FB"
      stroke: "#0B6FA4"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
    }
  }
  category_tooling: {
    shape: rectangle
    style: {
      fill: "#F2F4F7"
      stroke: "#3F4B5C"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
      3d: true
    }
  }
  category_layer: {
    shape: rectangle
    style: {
      fill: "#FFFFFF"
      stroke: "#8C8780"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
      double-border: true
    }
  }
  category_system_in_scope_frame: {
    shape: rectangle
    style: {
      fill: "#EEF2FF"
      stroke: "#4338CA"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
    }
  }
  category_layer_frame: {
    shape: rectangle
    style: {
      fill: transparent
      stroke: "#8C8780"
      stroke-width: 2
      font-color: "#0F172A"
      font-size: 15
      stroke-dash: 5
    }
  }
  line_acts_on: {
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      stroke-width: 2
      font-color: "#334155"
      font-size: 14
    }
  }
  line_read_only: {
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      stroke-width: 2
      font-color: "#334155"
      font-size: 14
      stroke-dash: 5
    }
  }
}
Title: {
  label: "Tooling layer — Component diagram"
  shape: text
  near: top-center
  style: {
    font-size: 24
    bold: true
    font-color: "#0F172A"
  }
}
"el_anthropic_api": {
  label: "Anthropic API\n[External system]"
  class: category_external_system
}
"el_praxion": {
  label: "Praxion\n[System in scope · Markdown, Python and shell]\nSkills, rules, commands and\nagents that equip an AI\ncoding assistant"
  class: category_system_in_scope_frame
  "el_praxion.knowledge": {
    label: "Knowledge\n[Layer]"
    class: category_layer
  }
  "el_praxion.orchestration": {
    label: "Orchestration\n[Layer]"
    class: category_layer_frame
    "el_praxion.orchestration.aiwork": {
      label: ".ai-work/\n[Pipeline document]\nEphemeral pipeline docs\n(task-slug scoped)"
      class: category_pipeline_document
    }
  }
  "el_praxion.tooling": {
    label: "Tooling\n[Layer]"
    class: category_layer_frame
    "el_praxion.tooling.dashboard": {
      label: "Pipeline Dashboard\n[Tooling]\nNext.js runtime, own process\n+ sha256-derived port;\nread-only over project state"
      class: category_tooling
    }
    "el_praxion.tooling.evals": {
      label: "Eval Framework\n[Tooling]\nOut-of-band quality\nmeasurement over completed\nartifacts"
      class: category_tooling
    }
    "el_praxion.tooling.installers": {
      label: "Installers\n[Tooling]\n3 targets"
      class: category_tooling
    }
    "el_praxion.tooling.versioning": {
      label: "Versioning\n[Tooling]\nCommitizen"
      class: category_tooling
    }
  }
}
Legend: {
  label: "Legend"
  near: bottom-center
  grid-columns: 3
  width: 1250
  horizontal-gap: 56
  vertical-gap: 12
  style: {
    fill: "#FFFFFF"
    stroke: "#8C8780"
    stroke-width: 1
    font-color: "#0F172A"
  }
  category_external_system: {
    label: "External system"
    class: category_external_system
  }
  category_pipeline_document: {
    label: "Pipeline document"
    class: category_pipeline_document
  }
  category_tooling: {
    label: "Tooling"
    class: category_tooling
  }
  category_layer: {
    label: "Layer"
    class: category_layer
  }
  category_system_in_scope_frame: {
    label: "System in scope (boundary)"
    class: category_system_in_scope_frame
  }
  category_layer_frame: {
    label: "Layer (boundary)"
    class: category_layer_frame
  }
  line_acts_on_sample: {
    label: ""
    direction: right
    style: {
      fill: transparent
      stroke-width: 0
    }
    tail: {
      label: ""
      shape: circle
      width: 8
      height: 8
      style: {
        fill: "#475569"
        stroke: "#475569"
      }
    }
    caption: {
      label: "acts on (invokes, writes)"
      style: {
        fill: transparent
        stroke-width: 0
        font-size: 14
        font-color: "#334155"
      }
    }
    tail -> caption: {
      class: line_acts_on
    }
  }
  line_read_only_sample: {
    label: ""
    direction: right
    style: {
      fill: transparent
      stroke-width: 0
    }
    tail: {
      label: ""
      shape: circle
      width: 8
      height: 8
      style: {
        fill: "#475569"
        stroke: "#475569"
      }
    }
    caption: {
      label: "read-only flow (consumed, not modified)"
      style: {
        fill: transparent
        stroke-width: 0
        font-size: 14
        font-color: "#334155"
      }
    }
    tail -> caption: {
      class: line_read_only
    }
  }
}
"el_praxion"."el_praxion.tooling"."el_praxion.tooling.dashboard" -> "el_praxion"."el_praxion.orchestration"."el_praxion.orchestration.aiwork": "reads in-flight documents" {class: line_read_only}
"el_praxion"."el_praxion.tooling"."el_praxion.tooling.evals" -> "el_anthropic_api": "judges via the JudgeClient adapter" {class: line_acts_on}
"el_praxion"."el_praxion.tooling"."el_praxion.tooling.installers" -> "el_praxion"."el_praxion.knowledge": "deploys +3 more" {class: line_acts_on}
