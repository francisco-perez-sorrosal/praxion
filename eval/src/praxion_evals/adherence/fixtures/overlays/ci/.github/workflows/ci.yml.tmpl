name: ci
on: [push]
permissions: write-all
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@main
      - uses: actions/setup-python@main
        with:
          python-version: "3.12"
      - run: pip install pytest
      - run: pip install -e .
      - run: python -m pytest
