"""Render entries as CSV or JSON text."""

import csv
import io
import json
from dataclasses import asdict

from ledger.store import Entry

FORMATS = ("csv", "json")


def render(entries: list[Entry], fmt: str) -> str:
    if fmt == "csv":
        return _to_csv(entries)
    if fmt == "json":
        return json.dumps([asdict(e) for e in entries])
    raise ValueError(f"unknown format: {fmt}")


def _to_csv(entries: list[Entry]) -> str:
    buffer = io.StringIO()
    writer = csv.writer(buffer)
    writer.writerow(["day", "label", "cents"])
    for entry in entries:
        writer.writerow([entry.day, entry.label, entry.cents])
    return buffer.getvalue()
