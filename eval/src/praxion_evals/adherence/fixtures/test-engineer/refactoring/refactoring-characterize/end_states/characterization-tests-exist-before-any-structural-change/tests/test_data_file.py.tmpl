from ledger.store import Entry, add_entry, load_entries

DATA_FILE_TEXT = """[
  {
    "day": "2026-01-02",
    "label": "coffee",
    "cents": 350
  }
]"""


def test_the_data_file_holds_indented_json_text(tmp_path):
    path = tmp_path / "ledger.json"
    add_entry(path, Entry("2026-01-02", "coffee", 350))
    assert path.read_text(encoding="utf-8") == DATA_FILE_TEXT


def test_a_data_file_reads_back_to_its_entries(tmp_path):
    path = tmp_path / "ledger.json"
    path.write_text(DATA_FILE_TEXT, encoding="utf-8")
    assert load_entries(path) == [Entry("2026-01-02", "coffee", 350)]
