#!/usr/bin/env bash
# praxion-hook-wrapper v1
#
# Generated by scripts/install_git_hooks.py — DO NOT EDIT BY HAND. Re-run
# `install_git_hooks.py --install` or `--heal` to regenerate.
#
# Hook class: {{HOOK_NAME}}. Composes a delegate hook (the team's pre-existing
# hook manager, or the occupant this wrapper preserved at
# `<name>.pre-praxion`) with Praxion's own step. The exit-code policy below is
# baked in at RENDER time (two distinct blocks the Python renderer chooses
# between, never a runtime `if $HOOK_CLASS` branch) so a future edit to one
# hook class's handling cannot silently touch the other (see the hook-chaining ADR).
set -eo pipefail

# Re-entrancy guard (defense-in-depth) — refuse to exec the delegate
# at chain depth >= 1. A correctly-configured wrapper never re-enters itself
# (the non-ping-pong invariant is enforced at install/heal time, before this
# file is ever written); this only fires if a delegate re-invokes git hooks
# directly.
PRAXION_HOOK_CHAIN_DEPTH="${PRAXION_HOOK_CHAIN_DEPTH:-0}"
if [ "$PRAXION_HOOK_CHAIN_DEPTH" -ge 1 ]; then
    echo "praxion-hook-wrapper: refusing to exec delegate at chain depth $PRAXION_HOOK_CHAIN_DEPTH (re-entrancy guard)" >&2
    _DELEGATE_STATUS=0
else
    # Resolve the delegate against the CURRENT worktree's root —
    # never frozen absolute at install time, so a linked worktree runs its
    # own copy of the team's hooks exactly as bare git would.
    _WORKTREE_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    _DELEGATE_RAW="{{DELEGATE_RAW}}"
    case "$_DELEGATE_RAW" in
        /*) _DELEGATE_ROOT="$_DELEGATE_RAW" ;;
        *)  _DELEGATE_ROOT="${_WORKTREE_ROOT}/${_DELEGATE_RAW}" ;;
    esac
    _DELEGATE_MODE="{{DELEGATE_MODE}}"
    if [ "$_DELEGATE_MODE" = "dir" ]; then
        _DELEGATE_PATH="${_DELEGATE_ROOT}/{{HOOK_NAME}}"
    else
        _DELEGATE_PATH="$_DELEGATE_ROOT"
    fi

    if [ -x "$_DELEGATE_PATH" ]; then
        if PRAXION_HOOK_CHAIN_DEPTH=$((PRAXION_HOOK_CHAIN_DEPTH + 1)) "$_DELEGATE_PATH" "$@"; then
            _DELEGATE_STATUS=0
        else
            _DELEGATE_STATUS=$?
        fi
    else
        _DELEGATE_STATUS=0
    fi
fi

{{DELEGATE_EXIT_HANDLING}}

{{PRAXION_STEP}}
