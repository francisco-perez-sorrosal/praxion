#!/usr/bin/env bash
# scripts/onboard-project — unified Praxion onboarding entry point.
#
# Absorbs new_project.sh's prereq-validation + greenfield-scaffold + Claude
# hand-off, and adds the bash-side half of the 6-state detection predicate
# table (skills/onboard-project/references/detection.md) so ANY project --
# empty, git-only, partially managed, fully managed, hackathon-managed, or
# code-with-no-git -- resolves to one mode (new/existing/hackathon/promote)
# through one script.
#
# Bounded bash-layer scope: this script detects STATE and hands off. It does
# NOT re-implement phase-level or capability-block-level classification --
# deep drift questions (are the installed capabilities current?) delegate to
# scripts/upgrade_project_pins.sh --check. The onboard-project SKILL is the
# authority on what gets written; this script only decides WHETHER to launch
# it and with what starting context (the 4-line seed-prompt trailer).
#
# Usage: onboard-project [<project-name> [<target-dir>]] [options]
#   Run 'onboard-project --help' for the full contract (examples-first).
#
# Exit codes: 0 ok/nothing-to-do, 2 usage, 3 no claude, 4 no plugin,
#             5 no git, 6 target exists & non-empty, 7 refused (guard),
#             8 --check only: work is pending.
#
# The sidecar-placement gate (scripts/onboard_placement.sh) reuses 2/3
# verbatim rather than adding new numbers: praxion-sidecar's own exit-code
# contract (INTERFACE_DESIGN.md D1) already fixes 2=usage/3=refused, and a
# delegated call's exit code passes straight through unmapped.
#
# See docs/onboarding.md for the full flow and troubleshooting matrix.

set -euo pipefail

# ---- Constants --------------------------------------------------------

readonly EXIT_OK=0
readonly EXIT_USAGE=2
readonly EXIT_NO_CLAUDE=3
readonly EXIT_NO_PLUGIN=4
readonly EXIT_NO_GIT=5
readonly EXIT_TARGET_EXISTS=6
readonly EXIT_REFUSED=7
readonly EXIT_CHECK_PENDING=8
# Same numeric value as EXIT_NO_CLAUDE by design (see the header comment
# above) -- the two never fire in the same run, since check_prereqs's
# `claude` check and the placement gate's own refusals sit on either side
# of a delegated call that cannot both succeed and be missing `claude`.
readonly EXIT_SIDECAR_REFUSED=3

readonly NAME_REGEX='^[A-Za-z0-9][A-Za-z0-9._-]*$'
readonly PLUGIN_KEY='praxion@bit-agora'
readonly SCRIPT_NAME='onboard-project'
readonly SCRIPT_VERSION='1.0.0'
readonly ALLOWED_TOOLS="mcp__chub__*,WebFetch,WebSearch,Bash(chub:*),Bash(uv:*),Bash(git:*),Bash(grep:*),Bash(pytest:*),Bash(test:*)"

# The 6-state predicate table -- single source of truth for the bash side.
# A committed test (tests/onboard_project_test.sh T12) asserts this literal
# set equals skills/onboard-project/references/detection.md's enumerated set.
readonly STATE_EMPTY='empty'
readonly STATE_HACKATHON_MANAGED='hackathon-managed'
readonly STATE_FULLY_MANAGED='fully-managed'
readonly STATE_PARTIALLY_MANAGED='partially-managed'
readonly STATE_GIT_NO_PRAXION='git-no-praxion'
readonly STATE_CODE_NO_GIT='code-no-git'

# ---- Config (mutated by parse_args) ------------------------------------

PROJECT_NAME=""
TARGET_DIR="$PWD"
TARGET_DIR_SET=0
MODE_OVERRIDE=""
FULL_FLAG=0
CHECK_ONLY=0
JSON_MODE=0
NO_LAUNCH=0
YES_FLAG=0
QUIET=0
VERBOSE=0
EDITOR_CHOICE="${PRAXION_NEW_PROJECT_EDITOR:-auto}"
CLAUDE_MD_MODE="generate"
BRIEF=""
GITHUB_FLAG=0
GITHUB_VISIBILITY="private"
PROFILE="standard"
CAPABILITIES_WITH=""
CAPABILITIES_WITHOUT=""
CAPABILITIES=""
PLACEMENT="in-repo"
PLACEMENT_SET=0
SHADOW_PATHS=()
SHARE_PATHS=()

# The placement x mode legality gate, the confirmation-block renderer, and
# delegation to `praxion-sidecar init` -- split out once this surface grew
# past onboard-project's own per-step size target (see WIP.md Batch 15
# implementer self-review). Sourced for its functions only; every global it
# reads is declared above.
source "$(dirname "$0")/onboard_placement.sh"

# Legacy opt-out env vars (deprecated; --hackathon / --without are current).
if [ "${PRAXION_NEW_PROJECT_HACKATHON:-}" = "1" ]; then
    printf '%s: PRAXION_NEW_PROJECT_HACKATHON is deprecated, use --hackathon\n' "$SCRIPT_NAME" >&2
    MODE_OVERRIDE="hackathon"
fi
if [ "${PRAXION_NEW_PROJECT_NO_AAC:-}" = "1" ]; then
    printf '%s: PRAXION_NEW_PROJECT_NO_AAC is deprecated, use --without aac\n' "$SCRIPT_NAME" >&2
    CAPABILITIES_WITHOUT="${CAPABILITIES_WITHOUT:+$CAPABILITIES_WITHOUT,}aac"
fi
if [ "${PRAXION_NEW_PROJECT_NO_OBSIDIAN:-}" = "1" ]; then
    printf '%s: PRAXION_NEW_PROJECT_NO_OBSIDIAN is deprecated, use --without obsidian\n' "$SCRIPT_NAME" >&2
    CAPABILITIES_WITHOUT="${CAPABILITIES_WITHOUT:+$CAPABILITIES_WITHOUT,}obsidian"
fi

# ---- Usage / help / version ---------------------------------------------

usage() {
    cat >&2 <<EOF
Usage: onboard-project [<project-name> [<target-dir>]] [options]
Run 'onboard-project --help' for examples and the full option reference.
EOF
}

print_version() {
    printf '%s %s (plugin %s)\n' "$SCRIPT_NAME" "$SCRIPT_VERSION" "$(plugin_version)"
}

print_help() {
    cat <<'EOF'
onboard-project — bring a project into the Praxion ecosystem.

USAGE
  onboard-project [<project-name> [<target-dir>]] [options]

EXAMPLES
  # Onboard the project you're standing in (most common)
  onboard-project

  # See what would change, without changing anything
  onboard-project --check

  # Create a new project and onboard it
  onboard-project my-app

  # Zero questions — accept every detected default
  onboard-project --yes

  # Start lean for a hackathon; promote to full later
  onboard-project my-app --hackathon
  onboard-project --full          # ...later, from inside the project

  # Pick capabilities explicitly
  onboard-project --with aac,ci --without obsidian

  # Also create the GitHub repo (new mode only; requires gh, authenticated)
  onboard-project my-app --github=private

CAPABILITIES
  core           always installed — gitignore, .ai-state/, hooks, merge driver,
                 settings, CLAUDE.md blocks, manifest
  arch           architecture baseline (.ai-state/DESIGN.md, docs/architecture.md)
  quality        editorconfig, linters, pre-commit, type config, CONTRIBUTING
  ci             CI autofix + cross-model review + label reconcile (needs 2 GitHub secrets)
  aac            Architecture-as-Code tier (fitness/, fences, workflow, diagrams)
  ml             ML/AI training conventions (auto-enabled when ML signals are detected)
  obsidian       Obsidian vault integration (auto-enabled when Obsidian is available)

PLACEMENT
  --placement <in-repo|sidecar>   Where durable Praxion state lives (default: in-repo).
                                   sidecar is legal only when the resolved mode is
                                   existing; prints a confirmation block, then
                                   delegates to `praxion-sidecar init`.
  --shadow <relpath>               Keep this path out of the project repo. Repeatable.
                                    Requires --placement sidecar.
  --share  <relpath>               Keep this path committed in the project repo.
                                    Repeatable. Requires --placement sidecar.

OPTIONS
  --mode <new|existing|hackathon|promote>   Force a mode (default: auto-detect)
  --hackathon                               Alias for --mode hackathon
  --full                                    Promote hackathon -> full, or no-op in existing mode
  --with <ids>                              Comma-separated capability IDs to install
  --without <ids>                           Comma-separated capability IDs to skip
  --profile <minimal|standard|all>          Named capability preset (default: standard)
  --yes, -y                                 Accept every default, ask nothing
  --check                                   Dry-run: detect, report, exit. Never writes.
  --json                                    Machine-readable output (pairs with --check)
  --no-launch                               Scaffold + print the plan; don't exec claude
  --quiet, -q                               Suppress informational output
  --verbose, -v                             Per-predicate detail
  --editor <auto|cursor|code|claude-desktop|none>  Where to open a new scaffold
  --claude-md <generate|stub|skip>          How to seed CLAUDE.md (default: generate)
  --brief "<text>"                          Skip the build-intent question (new mode)
  --github[=private|public]                 Also create the GitHub repo (new mode only)
  --version                                 Print resolved plugin + script version
  --help, -h                                Show this help

Deprecated (accepted for one release, then removed): --no-aac -> --without aac,
--no-obsidian -> --without obsidian.

Run `onboard-project --check` first if you're unsure. Nothing is ever committed.
EOF
}

# ---- Error messages (what / why / how-to-fix, always ending runnable) --

err_missing_claude() {
    cat >&2 <<'EOF'
Cannot onboard: Claude Code CLI not found on PATH.
The `claude` executable is required to run the onboarding skill.
Install it with:  npm install -g @anthropic-ai/claude-code
Then re-run:      onboard-project
EOF
}

err_missing_plugin() {
    local reg="$1"
    cat >&2 <<EOF
Cannot onboard: the Praxion plugin is not installed.
Checked ${reg} for \`${PLUGIN_KEY}\` — not found.
Install it with:  /plugin marketplace add bit-agora/praxion  then  /plugin install praxion
EOF
}

err_missing_git() {
    cat >&2 <<'EOF'
Cannot onboard: git not found on PATH.
The `git` executable is required to initialize and manage the project.
Install it with:  brew install git   (or your platform's package manager)
Then re-run:      onboard-project
EOF
}

err_plugin_source_repo() {
    local target="$1"
    cat >&2 <<EOF
Refusing to onboard: this is a Praxion plugin source repository.
Found .claude-plugin/plugin.json at ${target}; onboarding a plugin source
repo would install its own shipped artifacts into itself.
If this is intentional (dogfooding), re-run with:  PRAXION_ALLOW_SELF_ONBOARD=1 onboard-project
EOF
}

err_greenfield_shape() {
    local target="$1"
    cat >&2 <<EOF
Refusing to onboard: ${target} looks like a freshly-scaffolded greenfield
project (.git/ + AI-assistants .gitignore + .claude/ carrying only the seeded
permissions baseline + no source tree).
Run the new-project entry instead — it scaffolds the codebase via the agent
pipeline AND applies existing-project onboarding at the end:
  onboard-project <project-name> <target-dir>
EOF
}

err_target_exists() {
    local path="$1"
    cat >&2 <<EOF
Cannot create project: ${path} already exists and is not empty.
onboard-project scaffolds a new project into a fresh directory only.
To onboard it in place instead:  cd ${path} && onboard-project
EOF
}

err_bad_name() {
    local name="$1"
    cat >&2 <<EOF
Cannot create project: '${name}' is not a valid project name.
Project names must match ${NAME_REGEX} — start with a letter or digit,
then letters, digits, dots, underscores, or hyphens.
Pick a different name and re-run:  onboard-project <name>
EOF
}

err_gh_unavailable() {
    cat >&2 <<'EOF'
Cannot create GitHub repo: `gh` CLI not found or not authenticated.
--github requires the GitHub CLI, logged in to an account with repo-create scope.
Install/auth with:  brew install gh && gh auth login
Then re-run with:   onboard-project <name> --github
EOF
}

# ---- Prereqs -------------------------------------------------------------

resolve_plugin_registry() {
    printf '%s' "${HOME}/.claude/plugins/installed_plugins.json"
}

plugin_version() {
    local reg out
    reg="$(resolve_plugin_registry)"
    [ -f "$reg" ] || { printf 'unknown'; return; }
    # Scope to the first "version" line found AFTER the plugin key line, so a
    # top-level sibling like {"version": 2, "plugins": {...}} (schema version)
    # is never mistaken for this plugin's version. awk-only (no jq): the
    # sandboxed PATH this script may run under does not carry jq.
    out="$(awk -v key="\"${PLUGIN_KEY}\"" '
        $0 ~ key { seen=1 }
        seen && match($0, /"version"[[:space:]]*:[[:space:]]*"[^"]*"/) {
            v = substr($0, RSTART, RLENGTH)
            sub(/^"version"[[:space:]]*:[[:space:]]*"/, "", v)
            sub(/"$/, "", v)
            print v
            exit
        }
    ' "$reg" 2>/dev/null)" || true
    printf '%s' "${out:-unknown}"
}

check_prereqs() {
    if ! command -v claude >/dev/null 2>&1; then
        err_missing_claude
        exit "$EXIT_NO_CLAUDE"
    fi

    local reg
    reg="$(resolve_plugin_registry)"
    if [ ! -f "$reg" ] || ! grep -q "$PLUGIN_KEY" "$reg"; then
        err_missing_plugin "$reg"
        exit "$EXIT_NO_PLUGIN"
    fi

    if ! command -v git >/dev/null 2>&1; then
        err_missing_git
        exit "$EXIT_NO_GIT"
    fi
}

# ---- Name validation + collision check (new mode) -----------------------

validate_project_name() {
    local name="$1"
    if ! [[ "$name" =~ $NAME_REGEX ]]; then
        err_bad_name "$name"
        exit "$EXIT_USAGE"
    fi
}

check_no_collision() {
    local path="$1"
    if [ -e "$path" ] && [ -n "$(ls -A "$path" 2>/dev/null)" ]; then
        err_target_exists "$path"
        exit "$EXIT_TARGET_EXISTS"
    fi
}

# ---- Guards (detection.md §Guard) ----------------------------------------

guard_plugin_source_repo() {
    local target="$1"
    if [ -f "$target/.claude-plugin/plugin.json" ]; then
        if [ "${PRAXION_ALLOW_SELF_ONBOARD:-}" != "1" ]; then
            err_plugin_source_repo "$target"
            exit "$EXIT_REFUSED"
        fi
        printf 'Self-onboard override active — proceeding on plugin source repo at %s.\n' "$target"
    fi
}

has_source_markers() {
    local dir="$1" found=""
    [ -f "$dir/pyproject.toml" ] && return 0
    [ -f "$dir/package.json" ] && return 0
    [ -f "$dir/Cargo.toml" ] && return 0
    [ -f "$dir/go.mod" ] && return 0
    [ -d "$dir/src" ] && return 0
    found="$(find "$dir" -maxdepth 2 -type f \
        \( -name '*.py' -o -name '*.js' -o -name '*.ts' -o -name '*.go' -o -name '*.rs' -o -name '*.java' \) \
        2>/dev/null | head -n 1)" || true
    [ -n "$found" ]
}

# Only reachable when state == git-no-praxion (a bare .git already implied).
guard_greenfield_shape() {
    local target="$1"
    [ -f "$target/.gitignore" ] && grep -qF '# AI assistants' "$target/.gitignore" || return 0
    if [ -d "$target/.claude" ]; then
        local _claude_entries
        _claude_entries="$(ls -A "$target/.claude" 2>/dev/null | grep -v '^settings\.json$' || true)"
        [ -z "$_claude_entries" ] || return 0
    else
        return 0
    fi
    has_source_markers "$target" && return 0

    err_greenfield_shape "$target"
    exit "$EXIT_REFUSED"
}

# ---- State detection (detection.md §State detection) ---------------------

# Resolve the EFFECTIVE hooks directory for a project: core.hooksPath when it
# names a Praxion wrapper directory (scripts/install_git_hooks.py's chaining
# takeover, P0), else the plain .git/hooks. A project whose hooks are already
# chained has its finalize symlink inside the wrapper dir, not .git/hooks/ --
# a plain .git/hooks/post-merge check alone would misclassify it as
# git-no-praxion and re-onboard from scratch.
_effective_hooks_dir() {
    local dir="$1" hooks_path common_dir
    hooks_path="$(git -C "$dir" config --get core.hooksPath 2>/dev/null || true)"
    if [ -n "$hooks_path" ]; then
        case "$hooks_path" in
            /*) : ;;
            *)  hooks_path="$dir/$hooks_path" ;;
        esac
        common_dir="$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
        if [ -n "$common_dir" ] && [ -d "$hooks_path" ] \
            && [ "$(cd "$hooks_path" 2>/dev/null && pwd)" = "$common_dir/praxion-hooks" ]; then
            printf '%s' "$hooks_path"
            return
        fi
    fi
    printf '%s' "$dir/.git/hooks"
}

detect_state() {
    local dir="$1" stamp ai_state
    stamp="$dir/.ai-state/.praxion-onboard.json"
    ai_state="$dir/.ai-state"

    if [ ! -e "$dir" ] || [ -z "$(ls -A "$dir" 2>/dev/null)" ]; then
        printf '%s' "$STATE_EMPTY"; return
    fi
    if [ -f "$stamp" ]; then
        if grep -q '"mode"[[:space:]]*:[[:space:]]*"hackathon"' "$stamp"; then
            printf '%s' "$STATE_HACKATHON_MANAGED"; return
        fi
        printf '%s' "$STATE_FULLY_MANAGED"; return
    fi
    if [ -f "$dir/.claude/settings.json" ] \
        && grep -q '"PRAXION_HACKATHON_MODE"[[:space:]]*:[[:space:]]*"1"' "$dir/.claude/settings.json"; then
        printf '%s' "$STATE_HACKATHON_MANAGED"; return
    fi
    if [ -d "$ai_state" ] && [ -n "$(ls -A "$ai_state" 2>/dev/null)" ]; then
        printf '%s' "$STATE_PARTIALLY_MANAGED"; return
    fi
    if { [ -f "$dir/CLAUDE.md" ] && grep -q '^## Agent Pipeline$' "$dir/CLAUDE.md"; } \
        || { [ -f "$dir/CLAUDE.local.md" ] && grep -q '^## Agent Pipeline$' "$dir/CLAUDE.local.md"; }; then
        printf '%s' "$STATE_PARTIALLY_MANAGED"; return
    fi
    local effective_hooks_dir
    effective_hooks_dir="$(_effective_hooks_dir "$dir")"
    if [ -L "$effective_hooks_dir/post-merge" ]; then
        case "$(readlink "$effective_hooks_dir/post-merge")" in
            */git-finalize-hook.sh) printf '%s' "$STATE_PARTIALLY_MANAGED"; return ;;
        esac
    elif [ -f "$effective_hooks_dir/post-merge" ] \
        && head -n 5 "$effective_hooks_dir/post-merge" 2>/dev/null | grep -q '# praxion-hook-wrapper v1'; then
        # Chained wrapper file (occupied-slot or wrapper-dir case) -- not a
        # symlink, so classified separately from the plain-install case above.
        printf '%s' "$STATE_PARTIALLY_MANAGED"; return
    fi
    if [ -d "$dir/.git" ]; then
        printf '%s' "$STATE_GIT_NO_PRAXION"; return
    fi
    printf '%s' "$STATE_CODE_NO_GIT"
}

describe_praxion_state() {
    case "$1" in
        "$STATE_EMPTY")             printf 'not onboarded — empty directory' ;;
        "$STATE_FULLY_MANAGED")     printf 'onboarded' ;;
        "$STATE_HACKATHON_MANAGED") printf 'hackathon mode' ;;
        "$STATE_PARTIALLY_MANAGED") printf 'partially onboarded' ;;
        "$STATE_GIT_NO_PRAXION")    printf 'not onboarded — git repo, no Praxion state' ;;
        "$STATE_CODE_NO_GIT")       printf 'not onboarded — source present, no git' ;;
    esac
}

resolve_mode() {
    local state="$1"

    if [ "$FULL_FLAG" -eq 1 ]; then
        if [ "$state" = "$STATE_HACKATHON_MANAGED" ]; then
            printf 'promote'
        else
            printf 'existing'
        fi
        return
    fi

    if [ -n "$MODE_OVERRIDE" ]; then
        printf '%s' "$MODE_OVERRIDE"
        return
    fi

    case "$state" in
        "$STATE_EMPTY")             printf 'new' ;;
        "$STATE_HACKATHON_MANAGED") printf 'hackathon' ;;
        *)                          printf 'existing' ;;
    esac
}

# ---- Capability resolution (bounded: no phase/block-level logic here) ---

csv_to_spaced() {
    local input="$1" out="" tok IFS=','
    for tok in $input; do
        out="$out $tok"
    done
    printf '%s' "${out# }"
}

spaced_to_csv() {
    local input="$1" out="" tok
    for tok in $input; do
        if [ -z "$out" ]; then out="$tok"; else out="$out,$tok"; fi
    done
    printf '%s' "$out"
}

capability_list_contains() {
    case " $1 " in
        *" $2 "*) return 0 ;;
        *) return 1 ;;
    esac
}

default_capabilities_for_profile() {
    case "$1" in
        minimal)  printf 'core' ;;
        all)      printf 'core arch quality ci aac ml obsidian observability' ;;
        standard) printf 'core arch quality observability' ;;
        *)
            printf 'Usage error: --profile must be one of minimal|standard|all (got: %s)\n' "$1" >&2
            exit "$EXIT_USAGE" ;;
    esac
}

resolve_capabilities() {
    local base result item tok kept with_list without_list
    base="$(default_capabilities_for_profile "$PROFILE")"
    result="$base"

    if [ -n "$CAPABILITIES_WITH" ]; then
        with_list="$(csv_to_spaced "$CAPABILITIES_WITH")"
        for item in $with_list; do
            capability_list_contains "$result" "$item" || result="$result $item"
        done
    fi

    if [ -n "$CAPABILITIES_WITHOUT" ]; then
        without_list="$(csv_to_spaced "$CAPABILITIES_WITHOUT")"
        kept=""
        for tok in $result; do
            capability_list_contains "$without_list" "$tok" && continue
            kept="$kept $tok"
        done
        result="${kept# }"
    fi

    printf '%s' "$result"
}

# ---- Detection announcement (INTERFACE_DESIGN.md §2.4) -------------------

print_detection() {
    local target="$1" state="$2" mode="$3" version

    if [ "$JSON_MODE" -eq 1 ]; then
        printf '{"directory":"%s","state":"%s","mode":"%s"}\n' "$target" "$state" "$mode"
        return
    fi
    [ "$QUIET" -eq 1 ] && return 0

    version="$(plugin_version)"
    printf 'Praxion onboarding · plugin %s\n\n' "$version"
    printf '  Directory   %s\n' "$target"
    printf '  Praxion     %s\n' "$(describe_praxion_state "$state")"
    printf '\n  Mode        %s\n\n' "$mode"
}

# ---- --check (bounded: stamp presence + delegate drift to upgrade_project_pins.sh) --

run_check() {
    local target="$1" state="$2"
    local stamp="$target/.ai-state/.praxion-onboard.json"
    local pending=1 message=""

    case "$state" in
        "$STATE_FULLY_MANAGED"|"$STATE_HACKATHON_MANAGED")
            if [ -f "$stamp" ]; then
                local upgrade_script
                upgrade_script="$(dirname "$0")/upgrade_project_pins.sh"
                if [ -x "$upgrade_script" ] \
                    && "$upgrade_script" --repo-root "$target" --check >/dev/null 2>&1; then
                    pending=0
                    message="Nothing to do. $target is fully onboarded."
                elif [ -x "$upgrade_script" ]; then
                    message="Pending: drift found by upgrade_project_pins.sh --check."
                else
                    pending=0
                    message="Stamp present for $target; deep drift check unavailable (upgrade_project_pins.sh not found)."
                fi
            else
                message="Pending: $target has state $state but no onboarding stamp yet."
            fi
            ;;
        *)
            message="Pending: $target is not fully onboarded (detected state: $state)."
            ;;
    esac

    if [ "$JSON_MODE" -eq 1 ]; then
        local pending_bool="false"
        [ "$pending" -eq 1 ] && pending_bool="true"
        printf '{"pending":%s,"message":"%s"}\n' "$pending_bool" "$message"
    else
        printf '%s\n' "$message"
        if [ "$pending" -eq 1 ]; then
            printf 'Run `onboard-project` to apply, or `onboard-project --check --json` for machine output.\n'
        fi
    fi

    if [ "$pending" -eq 1 ]; then
        exit "$EXIT_CHECK_PENDING"
    fi
    exit "$EXIT_OK"
}

# ---- Scaffold (new mode; absorbed from new_project.sh) --------------------

scaffold_project() {
    local path="$1"
    mkdir -p "$path"
    cd "$path"
    git init -q
    mkdir -p .claude
    # Permissions baseline, seeded so the Phase 0s seed pipeline's subagents are
    # covered before they spawn (td-130; write access to .ai-work/ granted up
    # front rather than left for the first subagent to request). Canonical value:
    # skills/onboard-project/references/phases-core.md § Phase 5, sub-step 5b.
    # Kept in agreement by tests/onboard_project_test.sh::t13_scaffold_seeds_permissions_baseline.
    if [ ! -e .claude/settings.json ]; then
        cat > .claude/settings.json <<'EOF'
{
  "permissions": {
    "allow": [
      "Write(.ai-work/**)"
    ]
  }
}
EOF
    fi
    cat > .gitignore <<'EOF'
# AI assistants
.ai-work/
.ai-state/*.lock
.ai-state/**/*.lock
.ai-state/*.backup.json
.ai-state/observations.jsonl.1
.claude/settings.local.json
.claude/worktrees/
.env
.env.*
.env.local
tmp/
EOF
    [ "$QUIET" -eq 1 ] || printf 'Scaffolded %s at %s.\n' "$PROJECT_NAME" "$path"
}

# ---- Editor launch (new mode; kept as one function per the plan) ---------

launch_cursor_if_present() {
    command -v cursor >/dev/null 2>&1 || return 1
    cursor "$1" "$1/.gitignore" >/dev/null 2>&1 &
    EDITOR_LAUNCHED="cursor"
}

launch_code_if_present() {
    command -v code >/dev/null 2>&1 || return 1
    code "$1" "$1/.gitignore" >/dev/null 2>&1 &
    EDITOR_LAUNCHED="code"
}

launch_claude_desktop() {
    local path="$1"
    if [ "$(uname -s)" != "Darwin" ]; then
        printf '%s: --editor claude-desktop is only wired for macOS.\n' "$SCRIPT_NAME" >&2
        printf '  Open Claude Code desktop manually and select this folder: %s\n' "$path" >&2
        return 1
    fi
    if ! open -a "Claude" >/dev/null 2>&1; then
        printf '%s: could not launch Claude.app (is the desktop app installed?).\n' "$SCRIPT_NAME" >&2
        printf '  Install from https://claude.ai/download, then select: %s\n' "$path" >&2
        return 1
    fi
    if command -v pbcopy >/dev/null 2>&1; then
        printf '%s' "$path" | pbcopy
        EDITOR_DESKTOP_NOTE="path copied to clipboard — paste into 'Select folder'"
    else
        EDITOR_DESKTOP_NOTE="select this folder manually: $path"
    fi
    EDITOR_LAUNCHED="claude-desktop"
}

maybe_launch_editor() {
    local path="$1"
    EDITOR_LAUNCHED=""
    EDITOR_DESKTOP_NOTE=""

    case "$EDITOR_CHOICE" in
        auto)           launch_cursor_if_present "$path" || launch_code_if_present "$path" || true ;;
        cursor)         launch_cursor_if_present "$path" \
                            || printf '%s: --editor cursor but the cursor CLI is not on PATH.\n' "$SCRIPT_NAME" >&2 ;;
        code)           launch_code_if_present "$path" \
                            || printf '%s: --editor code but the code CLI is not on PATH.\n' "$SCRIPT_NAME" >&2 ;;
        claude-desktop) launch_claude_desktop "$path" || true ;;
        none)           ;;
        *)
            printf '%s: --editor %s not recognized; valid: auto|cursor|code|claude-desktop|none.\n' \
                "$SCRIPT_NAME" "$EDITOR_CHOICE" >&2 ;;
    esac

    [ "$QUIET" -eq 1 ] && return 0
    if [ "$EDITOR_LAUNCHED" = "claude-desktop" ]; then
        printf 'Launched Claude Code desktop app — %s.\n' "$EDITOR_DESKTOP_NOTE"
    elif [ -n "$EDITOR_LAUNCHED" ]; then
        printf 'Opened project in %s.\n' "$EDITOR_LAUNCHED"
    fi
}

# ---- GitHub repo creation (USER-DIRECTED ADDITION; new mode only, flag-only) --

maybe_create_github_repo() {
    local path="$1"
    [ "$GITHUB_FLAG" -eq 1 ] || return 0

    if ! command -v gh >/dev/null 2>&1 || ! gh auth status >/dev/null 2>&1; then
        err_gh_unavailable
        exit "$EXIT_USAGE"
    fi

    (cd "$path" && gh repo create "$PROJECT_NAME" "--$GITHUB_VISIBILITY" --source . --remote origin)
}

# ---- Seed prompt + hand-off ------------------------------------------------

build_seed_prompt() {
    local target="$1" mode="$2" state="$3"
    cat <<EOF
You are inside a Praxion project at ${target}. Invoke the onboard-project skill
now to bring this project into the Praxion ecosystem. The values below were
resolved by this launcher; the skill's own Phase 0 re-detection re-runs the
same predicates and uses its own result on disagreement, explaining why. Do
not ask me to invoke anything — begin now.

# Mode: ${mode}
# Detected state: ${state}
# Capabilities: ${CAPABILITIES}
# Brief: ${BRIEF}
EOF
}

launch_claude() {
    local target="$1" mode="$2" state="$3" seed_prompt
    seed_prompt="$(build_seed_prompt "$target" "$mode" "$state")"
    cd "$target"
    exec claude --permission-mode acceptEdits --allowedTools "$ALLOWED_TOOLS" -- "$seed_prompt"
}

# ---- Argument parsing -------------------------------------------------------

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --mode)
                [ $# -ge 2 ] || { printf 'Usage error: --mode requires a value\n' >&2; exit "$EXIT_USAGE"; }
                MODE_OVERRIDE="$2"; shift 2 ;;
            --hackathon)
                MODE_OVERRIDE="hackathon"; shift ;;
            --full)
                FULL_FLAG=1; shift ;;
            --with)
                [ $# -ge 2 ] || { printf 'Usage error: --with requires a value\n' >&2; exit "$EXIT_USAGE"; }
                CAPABILITIES_WITH="$2"; shift 2 ;;
            --without)
                [ $# -ge 2 ] || { printf 'Usage error: --without requires a value\n' >&2; exit "$EXIT_USAGE"; }
                CAPABILITIES_WITHOUT="$2"; shift 2 ;;
            --profile)
                [ $# -ge 2 ] || { printf 'Usage error: --profile requires a value\n' >&2; exit "$EXIT_USAGE"; }
                PROFILE="$2"; shift 2 ;;
            --placement)
                [ $# -ge 2 ] || { printf 'Usage error: --placement requires a value\n' >&2; exit "$EXIT_USAGE"; }
                PLACEMENT="$2"; PLACEMENT_SET=1; shift 2 ;;
            --shadow)
                [ $# -ge 2 ] || { printf 'Usage error: --shadow requires a value\n' >&2; exit "$EXIT_USAGE"; }
                SHADOW_PATHS+=("$2"); shift 2 ;;
            --share)
                [ $# -ge 2 ] || { printf 'Usage error: --share requires a value\n' >&2; exit "$EXIT_USAGE"; }
                SHARE_PATHS+=("$2"); shift 2 ;;
            --yes|-y)
                YES_FLAG=1; shift ;;
            --check)
                CHECK_ONLY=1; shift ;;
            --json)
                JSON_MODE=1; QUIET=1; shift ;;
            --no-launch)
                NO_LAUNCH=1; shift ;;
            --quiet|-q)
                QUIET=1; shift ;;
            --verbose|-v)
                VERBOSE=1; shift ;;
            --no-color)
                shift ;;
            --editor)
                [ $# -ge 2 ] || { printf 'Usage error: --editor requires a value\n' >&2; exit "$EXIT_USAGE"; }
                EDITOR_CHOICE="$2"; shift 2 ;;
            --claude-md)
                [ $# -ge 2 ] || { printf 'Usage error: --claude-md requires a value\n' >&2; exit "$EXIT_USAGE"; }
                CLAUDE_MD_MODE="$2"; shift 2 ;;
            --brief)
                [ $# -ge 2 ] || { printf 'Usage error: --brief requires a value\n' >&2; exit "$EXIT_USAGE"; }
                BRIEF="$2"; shift 2 ;;
            --github)
                GITHUB_FLAG=1; shift ;;
            --github=*)
                GITHUB_FLAG=1; GITHUB_VISIBILITY="${1#--github=}"; shift ;;
            --no-aac)
                printf '%s: --no-aac is deprecated, use --without aac\n' "$SCRIPT_NAME" >&2
                CAPABILITIES_WITHOUT="${CAPABILITIES_WITHOUT:+$CAPABILITIES_WITHOUT,}aac"
                shift ;;
            --no-obsidian)
                printf '%s: --no-obsidian is deprecated, use --without obsidian\n' "$SCRIPT_NAME" >&2
                CAPABILITIES_WITHOUT="${CAPABILITIES_WITHOUT:+$CAPABILITIES_WITHOUT,}obsidian"
                shift ;;
            --version)
                print_version; exit "$EXIT_OK" ;;
            --help|-h)
                print_help; exit "$EXIT_OK" ;;
            --)
                shift; break ;;
            -*)
                printf 'Usage error: unknown option %s\n' "$1" >&2
                usage
                exit "$EXIT_USAGE" ;;
            *)
                if [ -z "$PROJECT_NAME" ]; then
                    PROJECT_NAME="$1"
                elif [ "$TARGET_DIR_SET" -eq 0 ]; then
                    TARGET_DIR="$1"
                    TARGET_DIR_SET=1
                else
                    printf 'Usage error: unexpected argument %s\n' "$1" >&2
                    usage
                    exit "$EXIT_USAGE"
                fi
                shift ;;
        esac
    done
}

# ---- Main ------------------------------------------------------------------

main() {
    parse_args "$@"
    check_prereqs

    local target requested_new state mode

    if [ -n "$PROJECT_NAME" ]; then
        validate_project_name "$PROJECT_NAME"
        target="${TARGET_DIR%/}/${PROJECT_NAME}"
        check_no_collision "$target"
        requested_new=1
    else
        target="$PWD"
        requested_new=0
    fi

    if [ "$requested_new" -eq 0 ]; then
        guard_plugin_source_repo "$target"
    fi

    state="$(detect_state "$target")"

    if [ "$requested_new" -eq 0 ] && [ "$state" = "$STATE_GIT_NO_PRAXION" ]; then
        guard_greenfield_shape "$target"
    fi

    if [ "$MODE_OVERRIDE" = "new" ] && [ "$state" != "$STATE_EMPTY" ]; then
        printf 'Usage error: --mode new requires an empty target (detected: %s).\n' "$state" >&2
        exit "$EXIT_USAGE"
    fi

    mode="$(resolve_mode "$state")"
    CAPABILITIES="$(spaced_to_csv "$(resolve_capabilities)")"

    # Before any detection side effect (scaffold, --check, hand-off): the
    # placement x mode legality gate, the composition rules, and (on a legal
    # --placement sidecar request) the confirmation block + delegated
    # `praxion-sidecar init`. A no-op for the in-repo default.
    resolve_sidecar_placement "$target" "$mode"

    print_detection "$target" "$state" "$mode"

    if [ "$CHECK_ONLY" -eq 1 ]; then
        run_check "$target" "$state"
    fi

    if [ "$mode" = "new" ]; then
        scaffold_project "$target"
        maybe_create_github_repo "$target"
        maybe_launch_editor "$target"
    fi

    if [ "$NO_LAUNCH" -eq 1 ]; then
        if [ "$QUIET" -eq 0 ]; then
            printf 'Resolved plan (not launching). Seed prompt:\n\n%s\n' \
                "$(build_seed_prompt "$target" "$mode" "$state")"
        fi
        exit "$EXIT_OK"
    fi

    launch_claude "$target" "$mode" "$state"
}

main "$@"
